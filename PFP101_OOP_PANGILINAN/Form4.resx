    <value>Public Class BankAccount
    Private balance As Decimal    
    Public Sub Deposit(amount As Decimal)        
	If amount &gt; 0 Then           
	   balance += amount        
         End If   
    End Sub    

Public Function GetBalance() As Decimal
        Return balance   
End Function
End Class</value>
